 ================================
# Java artifacts
# ================================
*.class
*.jar
*.war
*.ear

# ================================
# IntelliJ IDEA
# ================================

# User-specific stuff (do NOT share)
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries/
.idea/shelf/
.idea/usage.statistics.xml
# Generated project files
.idea/*.iml
*.iml
out/
# IntelliJ caches
.idea/modules.xml
.idea/libraries/

# ================================
# Build output
# ================================
target/
build/
bin/

# ================================
# Logs
# ================================
*.log

# ================================
# OS-specific files
# ================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
Desktop.ini
# Linux
*~

# ================================
# Dependency JARs (keep libs/ clean in repo)
# ================================
lib/*.jar

# ================================
# Default ignored files
# ================================
/shelf/
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
